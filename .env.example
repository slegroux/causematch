SESSION_SECRET=
CAUSEMATCH_DB=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=
TWILIO_FROM_NUMBER=
EMAIL_API_KEY=
EMAIL_FROM=
# development|test|production. Required: unset (and not on Cloud Run) the app refuses to start.
# Cloud Run (K_SERVICE set) always counts as production.
CAUSEMATCH_ENV=
# 1 = no real texts; the code is 000000. Never in production.
CAUSEMATCH_FAKE_SMS=
# 1 = also seed invented demo orgs and openings in production (never on a real deploy)
CAUSEMATCH_SEED_DEMO=
# Origin for emailed sign-in links, e.g. https://causematch.org. Never read from the request.
PUBLIC_BASE_URL=
# 1 = no real emails; the sign-in link is logged instead. Needs CAUSEMATCH_ENV=development|test.
CAUSEMATCH_FAKE_EMAIL=
# Bearer token Cloud Scheduler sends to POST /tasks/reminders. Required in production.
TASKS_TOKEN=
