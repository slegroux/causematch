SESSION_SECRET=
CAUSEMATCH_DB=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=
TWILIO_FROM_NUMBER=
EMAIL_API_KEY=
EMAIL_FROM=
# development|test|preview|production. Required: unset (and not on Cloud Run) the app refuses to
# start. Cloud Run (K_SERVICE set) counts as production, unless it is a preview.
CAUSEMATCH_ENV=
# preview only, and required there (at least 16 characters): the HTTP Basic password on every request.
PREVIEW_PASSWORD=
# preview only: a folder with orgs.json, logos-raw/ and photos-raw/ seeded at startup (else invented orgs).
PREVIEW_SEED_DIR=
# 1 = no real texts; the code is 000000. Development, test and preview only.
CAUSEMATCH_FAKE_SMS=
# 1 = also seed invented demo orgs and openings in production (never on a real deploy)
CAUSEMATCH_SEED_DEMO=
# Origin for emailed sign-in links, e.g. https://causematch.org. Never read from the request.
PUBLIC_BASE_URL=
# 1 = no real emails; the sign-in link is logged instead. Needs CAUSEMATCH_ENV=development|test|preview.
CAUSEMATCH_FAKE_EMAIL=
# Bearer token Cloud Scheduler sends to POST /tasks/reminders. Required in production.
TASKS_TOKEN=
# Address shown on /privacy. Required in production.
CONTACT_EMAIL=
# Secret key for the one-way hash kept of a deleted account's phone when a block, report or
# suspension must outlive it (any long random string). Required in production.
PHONE_HASH_KEY=
# How many addresses the proxies in front append to X-Forwarded-For. 0 (default) = use the
# socket peer. Required on Cloud Run: 1 for the run.app URL, 2 behind an external load balancer.
TRUSTED_PROXY_HOPS=
# Ceiling on every text the app sends (sign-in codes and notifications). Defaults 100 and 500.
SMS_MAX_PER_HOUR=
SMS_MAX_PER_DAY=
# DEBUG adds the hashed client key to the log (for the TRUSTED_PROXY_HOPS check). Default INFO.
CAUSEMATCH_LOG_LEVEL=
